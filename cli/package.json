{
  "name": "@datasee/lookout-cli",
  "version": "0.2.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "CLI for lookout, the self-hosted Sentry-compatible error tracker. Browse and triage issues from the terminal, hand errors to Claude Code to fix (`lookout fix`), or run as an MCP server (`lookout mcp`).",
  "keywords": [
    "error-tracking",
    "error-monitoring",
    "sentry",
    "self-hosted",
    "lookout",
    "cli",
    "mcp",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datamaker/lookout.git",
    "directory": "cli"
  },
  "homepage": "https://github.com/datamaker/lookout#readme",
  "bugs": {
    "url": "https://github.com/datamaker/lookout/issues"
  },
  "author": "Jungbin Kwon <datamaker@datasee.co.kr>",
  "type": "module",
  "bin": {
    "lookout": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.3"
  }
}
